# ── Datenbank (PostgreSQL 14+; lokal oder Supabase-Postgres) ─────────────
DATABASE_URL=postgres://stamply:stamply@localhost:5432/stamply
# Nur für Tests (wird bei jedem Testlauf geleert!)
TEST_DATABASE_URL=postgres://stamply:stamply@localhost:5432/stamply_test

# ── App ──────────────────────────────────────────────────────────────────
# Öffentliche Basis-URL (für QR-Codes, Push-Links)
APP_URL=http://localhost:3000
# Geheimnis für HMAC-Signaturen (min. 32 Zeichen). Erzeugen: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Schützt /api/cron/dispatch (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-too

# ── Dateien ──────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
# Kassenbon-Bilder werden nach dieser Anzahl Tage nach Entscheidung gelöscht
RECEIPT_IMAGE_RETENTION_DAYS=30

# ── OCR ──────────────────────────────────────────────────────────────────
# tesseract (Open Source, läuft lokal) | none (alles geht in die manuelle Prüfung)
OCR_PROVIDER=tesseract
# Optional: Ordner mit deu.traineddata/eng.traineddata (sonst Download vom CDN beim ersten Lauf)
# OCR_LANG_PATH=./ocr-data

# ── Web Push (VAPID) – erzeugen mit: npm run vapid ───────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Marketing-Ruhezeiten (Ortszeit) ──────────────────────────────────────
APP_TIMEZONE=Europe/Berlin
QUIET_HOURS_START=21
QUIET_HOURS_END=9

# ── Zahlungen ────────────────────────────────────────────────────────────
# Nur "test" ist implementiert: Tarifwechsel ohne echte Zahlung, klar gekennzeichnet.
BILLING_MODE=test
