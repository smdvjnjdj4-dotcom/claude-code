{
  "name": "stamply",
  "version": "0.1.0",
  "private": true,
  "description": "STAMPLY – Discover Local. Earn Rewards.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "worker": "tsx scripts/worker.ts",
    "vapid": "tsx scripts/vapid.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
